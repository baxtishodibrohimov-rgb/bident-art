# Cliniccards API kalit: Настройки → Другое → Настройки клиники → API ключ
# Kalitni chatga yoki git'ga yozmang — faqat serverdagi .env faylga.
CLINICCARDS_TOKEN=

# Veb-sahifaga kirish uchun login va parol
HISOBOT_LOGIN=admin
HISOBOT_PAROL=

# Shu sanadan boshlab barcha ishlar ko'rib chiqiladi (Cliniccards'ning butun davri).
# Klinika Cliniccards'ga undan oldin o'tgan bo'lsa, ertaroq sana qo'ying.
BOSHLANISH_SANA=2015-01-01

# Shifokor foizlari saqlanadigan fayl
FOIZLAR_FAYL=foizlar.json

# (ixtiyoriy) Sessiya cookie'sini imzolash kaliti — uzun tasodifiy matn.
# Berilmasa, paroldan olinadi (parol o'zgarsa, hamma qaytadan kiradi).
SESSION_SECRET=

# Klinika ulushi: kassaga tushgan pulning necha foizi (Foizlar sahifasida ham o'zgartiriladi)
KLINIKA_FOIZ=20

# --- Sklad va Telegram bot ---
# @BotFather bergan token. Bu bot BOSHQA dasturda ishlatilmasligi kerak (aks holda xabarlar ikkiga bo'linadi).
TELEGRAM_BOT_TOKEN=
# Har kuni xodimlardan "skladdan narsa oldingizmi?" deb so'raladigan vaqt (Toshkent vaqti)
SKLAD_SOROV_VAQTI=19:00
# Bot xabarlarida ko'rinadigan klinika nomi
KLINIKA_NOMI=Biodent
# Sklad bazasi (Railway volume ichida bo'lsin)
DB_FAYL=/data/hisobot.db

# --- Xodimlar (shifokor bo'lmagan) ---
# Har kuni davomat ("bugun klinika ishladimi, kimlar keldi?") so'raladigan vaqt
DAVOMAT_VAQTI=20:00
# Dam olish kunlari (0=dushanba ... 6=yakshanba); shu kuni ishlaganga qo'shimcha to'lanadi
DAM_OLISH_KUNLARI=6
# Shifokorlar ulushi, % (Foizlar sahifasida ham o'zgartiriladi). Xarajatlar = 100 − klinika − shifokorlar
SHIFOKOR_FOIZ=25
